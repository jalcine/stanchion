; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Stanchion Chess"
config/description="Chess whose rules live in Godot and whose plays are sandboxed Lua plugins loaded through Stanchion."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1120
window/size/viewport_height=700
window/size/resizable=true
; Scale the whole game up or down to fill a resized window, keeping the aspect ratio.
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
